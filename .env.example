APP_NAME=Tenant
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# APP_URL=http://localhost
# APP_URL=http://localhost:8000
APP_URL=http://localhost:8001
# IP proxy tepercaya (pisahkan koma) — isi hanya jika di belakang reverse proxy
# TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tenancy_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
ALLOW_LOCAL_LOGIN=true
ENFORCE_PASSWORD_CHANGE=false
AUTH_MODE=local

# SSO SAML2 Gate perusahaan
# SSO_REDIRECT_URI=http://localhost:8000/auth/sso/callback
SSO_REDIRECT_URI=http://localhost:8001/auth/sso/callback
SAML_METADATA_URL=https://gate.appdutamall.com/saml/metadata
SAML_IDP_SSO_URL=https://gate.appdutamall.com/saml/sso
SAML_IDP_SLO_URL=https://gate.appdutamall.com/saml/slo
# SAML_SPENTITY_ID=http://localhost:8000/auth/sso/callback
SAML_SPENTITY_ID=http://localhost:8001/auth/sso/callback
# SAML_SP_ACS_URL=http://localhost:8000/auth/sso/callback
SAML_SP_ACS_URL=http://localhost:8001/auth/sso/callback
# SAML_SP_SLS_URL=http://localhost:8000/auth/sso/slo
SAML_SP_SLS_URL=http://localhost:8001/auth/sso/slo
SAML_NAME_ID_FORMAT=urn:oasis:names:tc:SAML:2.0:nameid-format:persistent
SAML_SP_SIGN_ASSERTIONS=false
SAML_CLOCK_SKEW=600

# Gate REST (data karyawan)
GATE_BASE_URL=https://gate.appdutamall.com
GATE_TOKEN=
GATE_TIMEOUT=15
# true (default) = scheduler dijalankan dari request HTTP saat tidak ada cron.
# Production dengan cron: set false.
# GATE_PACU_ENABLED=false

# Permit time lock (22:50 - 09:50 WITA)
PERMIT_TIME_LOCK_ENABLED=false
PERMIT_TIME_LOCK_START=22:50
PERMIT_TIME_LOCK_END=09:50
PERMIT_TIME_LOCK_TIMEZONE=Asia/Makassar
# HCIS webhook sinkron karyawan (kosongkan = endpoint menolak semua request)
HCIS_WEBHOOK_SECRET=
# Set true saat webhook HCIS sudah live (matikan tandai-hilang pull Gate)
HCIS_STATUS_AUTHORITY=false
