# Salin ke .env di server production, lalu isi nilai setiap variabel.
# JANGAN commit file .env asli.

APP_NAME=Tenant
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tenant.example.com
# IP reverse proxy tepercaya (Cloudflare/shared hosting) — kosongkan jika tidak yakin
# TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Log wajib rotate
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true jika seluruh akses lewat HTTPS
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Autentikasi -------------------------------------------------------------
# SSO Gate = satu-satunya jalur login normal.
AUTH_MODE=sso
# Login lokal (NIK+password) hanya break-glass. Lihat README "Break-glass login".
ALLOW_LOCAL_LOGIN=false
ENFORCE_PASSWORD_CHANGE=false

# --- SSO SAML2 Gate ----------------------------------------------------------
SSO_REDIRECT_URI=https://tenant.example.com/auth/sso/callback
SAML_METADATA_URL=https://gate.appdutamall.com/saml/metadata
SAML_IDP_SSO_URL=https://gate.appdutamall.com/saml/sso
SAML_IDP_SLO_URL=https://gate.appdutamall.com/saml/slo
SAML_SPENTITY_ID=https://tenant.example.com/auth/sso/callback
SAML_SP_ACS_URL=https://tenant.example.com/auth/sso/callback
SAML_SP_SLS_URL=https://tenant.example.com/auth/sso/slo
SAML_NAME_ID_FORMAT=urn:oasis:names:tc:SAML:2.0:nameid-format:persistent
SAML_SP_SIGN_ASSERTIONS=false
SAML_CLOCK_SKEW=600
# Sertifikat/key tanda tangan SP (isi jika Gate membutuhkan)
# SAML_SP_CERT=
# SAML_SP_PRIVATE_KEY=
# SAML_SP_PRIVATE_KEY_PASSPHRASE=

# --- Gate REST (data karyawan) ------------------------------------------------
GATE_BASE_URL=https://gate.appdutamall.com
GATE_TOKEN=
# Turunkan dari default 15 agar tidak menahan proses terlalu lama
GATE_TIMEOUT=8
# false = JANGAN jalankan scheduler dari dalam request HTTP.
# Wajib false di production karena cron sudah menjalankan schedule:run.
GATE_PACU_ENABLED=false

# --- Permit time lock (22:50 - 09:50 WITA) -----------------------------------
PERMIT_TIME_LOCK_ENABLED=false
PERMIT_TIME_LOCK_START=22:50
PERMIT_TIME_LOCK_END=09:50
PERMIT_TIME_LOCK_TIMEZONE=Asia/Makassar
